---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ensaios, notas e poesias pessoais.' } = Astro.props;
const siteName = 'Caderno por Gregory de Albuquerque';
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <p class="site-title"><a href="/">Caderno por Gregory de Albuquerque</a></p>
      <nav class="site-nav">
        <a href="/">início</a>
        <a href="/ensaios">ensaios</a>
        <a href="/notes">notas</a>
        <a href="/poesias">poesias</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} — Caderno por Gregory de Albuquerque.</p>
    </footer>
  </body>
</html>
